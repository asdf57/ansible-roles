apiVersion: v1
kind: Config
clusters:
  - name: cluster
    cluster:
      server: {{ node_drain_server }}
      certificate-authority: /etc/kubernetes/pki/ca.crt
users:
  - name: homelab-node-drain
    user:
      token: {{ node_drain_token }}
contexts:
  - name: drain
    context: {cluster: cluster, user: homelab-node-drain}
current-context: drain
