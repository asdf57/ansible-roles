[Unit]
Description=Test-only: remove all containerd state and host-local IP reservations before containerd starts
DefaultDependencies=no
After=local-fs.target
Before=containerd.service

[Service]
Type=oneshot
ExecStart=/bin/rm -rf --one-file-system /var/lib/containerd
# No sandbox survives the wipe, so every host-local reservation is stale (as in the prod wipe script).
ExecStart=/bin/rm -rf --one-file-system /var/lib/cni/networks

[Install]
WantedBy=containerd.service
