#!/bin/sh
# Freeze kube-proxy until Flannel writes subnet.env; give up after 180s. cgroup v1 or v2.
if [ -f /sys/fs/cgroup/cgroup.controllers ]; then file=cgroup.freeze on=1 off=0; else file=freezer.state on=FROZEN off=THAWED; fi
cg=
trap '[ -n "$cg" ] && echo $off > "$cg/$file"' EXIT
for _ in $(seq 900); do
    [ -s /run/flannel/subnet.env ] && exit 0
    if [ -z "$cg" ] && pid=$(pgrep -xo kube-proxy); then
        cg=/sys/fs/cgroup$(awk -F: -v f=$file '(f == "cgroup.freeze" && $1 == 0) { print $3 } (f == "freezer.state" && $2 ~ /(^|,)freezer(,|$)/) { print "/freezer" $3 }' "/proc/$pid/cgroup")
        echo $on > "$cg/$file"
    fi
    sleep 0.2
done
