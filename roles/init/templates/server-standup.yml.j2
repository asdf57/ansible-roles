resources:
  - name: inventory-trigger
    type: git
    check_every: 720h
    webhook_token: ((github/webhook.key))
    source:
      uri: "{{ publication_repository.json.spec.url }}"
      branch: "{{ inventory_publication.spec.target.branch }}"
      private_key: ((automation/git-ssh-key.privateKey))

jobs:
  - name: standup
    plan:
      - get: inventory-trigger
        trigger: true
      - task: show-inventory-capture-group
        privileged: true
        config:
          platform: linux
          image_resource:
            type: registry-image
            source:
              repository: "{{ registry_fqdn }}/arch-provisioner"
              tag: latest
          inputs:
            - name: inventory-trigger
          params:
            STIGMERGY_API_URL: "{{ lookup('env', 'STIGMERGY_API_URL') }}"
            INVENTORY_CAPTURE_GROUP_NAME: "{{ inventory_publication.spec.inventoryCaptureGroupRef.name }}"
            IS_BOOTSTRAP_ENV: "false"
          run:
            path: /bin/bash
            user: keiichi
            dir: /homelab
            args:
              - -lc
              - |
                  set -euo pipefail
                  echo "Standup pipeline for ${INVENTORY_CAPTURE_GROUP_NAME}"
                  curl -fsS "${STIGMERGY_API_URL%/}/api/v1alpha1/inventory-capture-groups/${INVENTORY_CAPTURE_GROUP_NAME}" | jq .
