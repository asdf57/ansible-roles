volumes:
  ssl_certs:
    driver: local
  openbao_shared:
    driver: local
  openbao_data:
    driver: local
  openbao_init:
    driver: local
  openbao_bootstrap:
    driver: local
  openbao_runtime:
    driver: local
  etcd_data:
    driver: local
  concourse_keys:
    driver: local

services:
  webhook:
    build: ./webhook
    ports:
      - "3001:3000"
    restart: always
    networks:
      clusternet:
        ipv4_address: "{{ webhook_ipv4 }}"
    environment:
        WEBHOOK_TOKEN: "${GITHUB_WEBHOOK_SECRET}"
        CI_URL: "{{ concourse_fqdn }}"
  registry:
    image: registry
    container_name: registry
    restart: always
    ports:
      - 5000:5000
    volumes:
      - "{{ host_data_path }}/registry/data:/var/lib/registry:rw"
    networks:
      clusternet:
        ipv4_address: "{{ registry_ipv4 }}"

  vikunja:
    image: "vikunja/vikunja:{{ vikunja_version }}"
    container_name: vikunja
    environment:
      VIKUNJA_DATABASE_PATH: /db/vikunja.db
      VIKUNJA_SERVICE_PUBLICURL: "https://{{ vikunja_fqdn }}/"
      VIKUNJA_SERVICE_SECRET_FILE: /run/secrets/vikunja-service-secret
    volumes:
      - "{{ host_data_path }}/vikunja/files:/app/vikunja/files"
      - "{{ host_data_path }}/vikunja/db:/db"
      - "{{ host_data_path }}/vikunja/service-secret:/run/secrets/vikunja-service-secret:ro"
    restart: unless-stopped
    networks:
      clusternet:
        ipv4_address: "{{ vikunja_ipv4 }}"

  iso-sync:
    image: ghcr.io/oras-project/oras:v1.3.4
    entrypoint: [/bin/sh, /sync/sync.sh]
    depends_on:
      - registry
    volumes:
      - "{{ host_data_path }}/iso-sync/sync.sh:/sync/sync.sh:ro"
      - "{{ host_data_path }}/nginx/files:/www/data"
    restart: always
    networks:
      - clusternet

  concourse-keys:
    image: alpine
    container_name: concourse-keys
    command: |
      sh -c "
        apk add --no-cache openssh-client
        if [ ! -f /concourse-keys/session_signing_key ]; then
          ssh-keygen -t rsa -m PEM -f /concourse-keys/session_signing_key -N ''
          ssh-keygen -t rsa -m PEM -f /concourse-keys/tsa_host_key -N ''
          cp /concourse-keys/session_signing_key.pub /concourse-keys/authorized_worker_keys
        fi
        exit 0
      "
    volumes:
      - concourse_keys:/concourse-keys
    restart: on-failure

  concourse-db:
    container_name: concourse-db
    image: postgres
    environment:
      POSTGRES_DB: concourse
      POSTGRES_PASSWORD: concourse_pass
      POSTGRES_USER: concourse_user
      PGDATA: /database
      POSTGRES_HOST_AUTH_METHOD: trust
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U concourse_user -d concourse"]
      interval: 3s
      timeout: 3s
      retries: 5
    networks:
      clusternet:
        ipv4_address: "{{ concourse_db_ipv4 }}"

  concourse-web:
    container_name: concourse-web
    build:
      context: ./concourse
      args:
        CONCOURSE_VERSION: "{{ concourse_version }}"
    command: web
    privileged: true
    depends_on:
      concourse-db:
        condition: service_healthy
      concourse-keys:
        condition: service_completed_successfully
      openbao-bootstrap:
        condition: service_completed_successfully
    ports:
      - "2222:2222"
    volumes:
      - concourse_keys:/concourse-keys
      - openbao_shared:/shared
    environment:
      CONCOURSE_SESSION_SIGNING_KEY: /concourse-keys/session_signing_key
      CONCOURSE_TSA_HOST_KEY: /concourse-keys/tsa_host_key
      CONCOURSE_TSA_AUTHORIZED_KEYS: /concourse-keys/authorized_worker_keys
      CONCOURSE_POSTGRES_HOST: "{{ concourse_db_ipv4 }}"
      CONCOURSE_POSTGRES_USER: concourse_user
      CONCOURSE_POSTGRES_PASSWORD: concourse_pass
      CONCOURSE_POSTGRES_DATABASE: concourse
      CONCOURSE_EXTERNAL_URL: "{{ concourse_url }}"
      CONCOURSE_ADD_LOCAL_USER: "{{ concourse_user }}:${CONCOURSE_PASSWORD}"
      CONCOURSE_MAIN_TEAM_LOCAL_USER: "{{ concourse_user }}"
      CONCOURSE_CLUSTER_NAME: homelab
      CONCOURSE_VAULT_URL: http://openbao:8200
      CONCOURSE_VAULT_PATH_PREFIX: /kv2/secrets
      CONCOURSE_VAULT_LOOKUP_TEMPLATES: '/{% raw %}{{.Secret}}{% endraw %}'
      CONCOURSE_VAULT_ENABLE_KV_MOUNT_CACHE: "true"
    restart: always
    networks:
      default:
      clusternet:
        ipv4_address: "{{ concourse_ipv4 }}"

  concourse-worker:
    container_name: concourse-worker
    build:
      context: ./concourse
      args:
        CONCOURSE_VERSION: "{{ concourse_version }}"
    command: worker
    privileged: true
    cgroup: host
    depends_on:
      - concourse-web
    volumes:
      - concourse_keys:/concourse-keys
      - openbao_shared:/shared
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      CONCOURSE_TSA_HOST: concourse-web:2222
      CONCOURSE_TSA_PUBLIC_KEY: /concourse-keys/tsa_host_key.pub
      CONCOURSE_TSA_WORKER_PRIVATE_KEY: /concourse-keys/session_signing_key
      CONCOURSE_RUNTIME: containerd
      CONCOURSE_CONTAINERD_ALLOW_HOST_ACCESS: "true"
      CONCOURSE_VAULT_URL: http://openbao:8200
      CONCOURSE_CONTAINERD_DNS_PROXY_ENABLE: "true"
    restart: always
    networks:
      - default
      - clusternet

  openbao:
    image: ghcr.io/openbao/openbao:2.6.1
    container_name: openbao
    command:
      - server
      - -config=/openbao/config/openbao.hcl
    ports:
      - 8200:8200
    cap_add:
      - IPC_LOCK
    restart: always
    volumes:
      - openbao_data:/openbao/file
      - "{{ host_data_path }}/openbao/openbao.hcl:/openbao/config/openbao.hcl:ro"
    environment:
      BAO_ADDR: "http://127.0.0.1:8200"
      BAO_API_ADDR: "http://openbao:8200"
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q --spider 'http://127.0.0.1:8200/v1/sys/health?standbyok=true&sealedcode=200&uninitcode=200'
      interval: 3s
      timeout: 2s
      retries: 20
      start_period: 3s

  openbao-volume-init:
    image: ghcr.io/openbao/openbao:2.6.1
    user: "0:0"
    entrypoint: [/bin/sh, -ec]
    command:
      - |
        chown 100:1000 /run/openbao-init /run/openbao-bootstrap /run/openbao /shared
        chmod 0700 /run/openbao-init /run/openbao-bootstrap
        chmod 0750 /run/openbao /shared
    volumes:
      - openbao_init:/run/openbao-init
      - openbao_bootstrap:/run/openbao-bootstrap
      - openbao_runtime:/run/openbao
      - openbao_shared:/shared

  openbao-bootstrap:
    image: ghcr.io/openbao/openbao:2.6.1
    entrypoint: [/bin/sh, /openbao/bootstrap/openbao-bootstrap.sh]
    environment:
      BAO_ADDR: http://openbao:8200
    depends_on:
      openbao:
        condition: service_healthy
      openbao-volume-init:
        condition: service_completed_successfully
    volumes:
      - "{{ host_data_path }}/openbao/openbao-bootstrap.sh:/openbao/bootstrap/openbao-bootstrap.sh:ro"
      - "{{ host_data_path }}/openbao/openbao-api-policy.hcl:/openbao/bootstrap/openbao-api-policy.hcl:ro"
      - "{{ host_data_path }}/openbao/concourse-policy.hcl:/openbao/bootstrap/concourse-policy.hcl:ro"
      - openbao_init:/run/openbao-init
      - openbao_bootstrap:/run/openbao-bootstrap
      - openbao_shared:/shared

  openbao-agent:
    image: ghcr.io/openbao/openbao:2.6.1
    command:
      - agent
      - -config=/openbao/agent/openbao-agent.hcl
    depends_on:
      openbao-bootstrap:
        condition: service_completed_successfully
    restart: unless-stopped
    volumes:
      - "{{ host_data_path }}/openbao/openbao-agent.hcl:/openbao/agent/openbao-agent.hcl:ro"
      - openbao_bootstrap:/run/openbao-bootstrap:ro
      - openbao_runtime:/run/openbao
    healthcheck:
      test: ["CMD-SHELL", "test -s /run/openbao/token"]
      interval: 3s
      timeout: 2s
      retries: 20
      start_period: 3s

  etcd:
    image: gcr.io/etcd-development/etcd:v3.6.13
    command:
      - /usr/local/bin/etcd
      - --name=etcd
      - --data-dir=/etcd-data
      - --listen-client-urls=http://0.0.0.0:2379
      - --advertise-client-urls=http://etcd:2379
      - --listen-peer-urls=http://0.0.0.0:2380
      - --initial-advertise-peer-urls=http://etcd:2380
      - --initial-cluster=etcd=http://etcd:2380
      - --initial-cluster-state=new
      - --auto-compaction-mode=periodic
      - --auto-compaction-retention=1h
    volumes:
      - etcd_data:/etcd-data
    ports:
      - "127.0.0.1:2379:2379"
    healthcheck:
      test: ["CMD", "/usr/local/bin/etcdctl", "--endpoints=http://127.0.0.1:2379", "endpoint", "health"]
      interval: 2s
      timeout: 2s
      retries: 15
      start_period: 2s

  stigmergy:
    build: ./stigmergy
    container_name: stigmergy
    environment:
      HTTP_ADDR: 0.0.0.0:8080
      ETCD_ENDPOINTS: http://etcd:2379
      PUBLIC_API_URL: "https://{{ stigmergy_fqdn }}"
      COMMAND_RUNNER_IMAGE: "{{ registry_fqdn }}/arch-provisioner:latest"
      ANSIBLE_ROLES_REPOSITORY: "{{ lookup('env', 'GIT_ANSIBLE_ROLES_REPO') }}"
      ANSIBLE_ROLES_REVISION: "{{ lookup('env', 'GIT_ANSIBLE_ROLES_REF') }}"
    depends_on:
      etcd:
        condition: service_healthy
      openbao-agent:
        condition: service_healthy
    ports:
      - "0.0.0.0:8080:8080"
    volumes:
      - openbao_runtime:/run/openbao:ro
    group_add:
      - "1000"
    init: true
    restart: always

  nginx:
    build: ./nginx
    container_name: nginx
    networks:
      default:
      clusternet:
        ipv4_address: "{{ nginx_ipv4 }}"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - "{{ host_data_path }}/nginx/files:/www/data"
      - ssl_certs:/etc/nginx/ssl:rw
    restart: always
    labels:
      - sh.acme.autoload.domain={{ nginx_acme_label }}

  dnsmasq:
    build: ./dnsmasq
    network_mode: host
    depends_on:
      - nginx
    restart: always
    cap_add:
      - NET_ADMIN

  acme:
    build: ./acme
    container_name: acme
    network_mode: host
    environment:
      - CF_Token=${CLOUDFLARE_API_KEY}
      - CF_Email=${CLOUDFLARE_EMAIL}
      - ACME_DOMAIN={{ cloudflare_domain }}
      - ACME_SERVER={{ cert_authority }}
      - ZEROSSL_EAB_KID=${ZEROSSL_EAB_KID}
      - ZEROSSL_EAB_HMAC_KEY=${ZEROSSL_EAB_HMAC_KEY}
      - ZEROSSL_EMAIL=${ZEROSSL_EMAIL}
      - DNS_API=dns_cf
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - "{{ host_data_path }}/acme/acme.sh:/acme.sh"
      - ssl_certs:/certs:rw
    restart: always
    depends_on:
      - nginx
    healthcheck:
      test: ["CMD", "test", "-f", "/done"]
      interval: 10s
      retries: 5000
      start_period: 10s

networks:
  clusternet:
    driver: "{{ network_driver }}"
    driver_opts:
      mode: "{{ ipvlan_mode if network_driver == 'ipvlan' else macvlan_mode }}"
      parent: "{{ ansible_facts['default_ipv4']['interface'] }}"
    ipam:
      config:
        - subnet: "{{ ipvlan_subnet if network_driver == 'ipvlan' else macvlan_subnet }}"
          gateway: "{{ ipvlan_gateway if network_driver == 'ipvlan' else macvlan_gateway }}"
