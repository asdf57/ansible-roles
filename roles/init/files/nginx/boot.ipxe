#!ipxe

dhcp

echo Booting system with MAC: ${net0/mac}
echo Resolving the Server bound to this switch port...

# Nginx proxies this path to Stigmergy. Stigmergy uses the observed NIC MAC to
# find the Machine, then follows its LLDP-location-based Server binding.
chain http://nginx.ryuugu.dev/ipxe/${net0/mac}
