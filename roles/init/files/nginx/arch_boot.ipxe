#!ipxe

echo Arch iPXE bootloader

kernel http://copyparty.ryuugu.dev/netboot/arch/vmlinuz \
    ip=dhcp \
    cow_spacesize=512M \
    archisobasedir=arch \
    archiso_http_srv=http://copyparty.ryuugu.dev/netboot/arch/ \
    initrd=initrd

initrd http://copyparty.ryuugu.dev/netboot/arch/initrd.img

boot
